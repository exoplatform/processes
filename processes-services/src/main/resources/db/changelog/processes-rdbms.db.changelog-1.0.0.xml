<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">

    <!-- Managing both DB that use sequences and db that use auto increment -->
    <property name="autoIncrement" value="true" dbms="mysql,mssql,h2,sybase,db2,hsqldb"/>
    <property name="autoIncrement" value="false" dbms="oracle,postgresql"/>

    <!-- Managing auto generation of timestamp by Database -->
    <property name="now" value="now()" dbms="mysql,hsqldb,postgresql,h2"/>
    <property name="now" value="sysdate" dbms="oracle"/>
    <property name="now" value="CURRENT_TIMESTAMP" dbms="mssql"/>


    <changeSet author="processes" id="1.0.0-0">
        <createTable tableName="PROCESSES_WORK_FLOW">
            <column name="WORK_FLOW_ID" type="BIGINT" autoIncrement="${autoIncrement}" startWith="1">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_WORK_FLOW"/>
            </column>
            <column name="TITLE" type="NVARCHAR(250)">
                <constraints nullable="false"/>
            </column>
            <column name="DESCRIPTION" type="NVARCHAR(2000)">
                <constraints nullable="false"/>
            </column>
            <column name="SUMMARY" type="NVARCHAR(2000)">
                <constraints nullable="false"/>
            </column>
            <column name="ENABLED" type="BOOLEAN"/>
            <column name="HELP_LINK" type="NVARCHAR(250)"/>
            <column name="IMAGE" type="NVARCHAR(250)"/>
            <column name="CREATOR_ID" type="BIGINT"/>
            <column name="CREATED_DATE" type="DATE"/>
            <column name="MODIFIER_ID" type="BIGINT"/>
            <column name="MODIFIED_DATE" type="DATE"/>
            <column name="PROJECT_ID" type="BIGINT">
                <constraints unique="true" uniqueConstraintName="UK_PROCESSES_WORK_FLOW_PROJECT_ID"/>
            </column>
        </createTable>
        <modifySql dbms="mysql">
            <append value=" ENGINE=INNODB CHARSET=UTF8 COLLATE utf8_general_ci"/>
        </modifySql>
    </changeSet>

    <changeSet author="processes" id="1.0.0-1" dbms="hsqldb,oracle,postgresql">
        <createSequence sequenceName="SEQ_WORK_FLOW_ID" startValue="1"/>
    </changeSet>

    <changeSet author="processes" id="1.0.0-2">
        <validCheckSum>ANY</validCheckSum>
        <createTable tableName="PROCESSES_WORK">
            <column name="WORK_ID" type="BIGINT" autoIncrement="${autoIncrement}" startWith="1">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_WORK"/>
            </column>
            <column name="TITLE" type="NVARCHAR(250)" />
            <column name="DESCRIPTION" type="NVARCHAR(2000)">
                <constraints nullable="false"/>
            </column>
            <column name="CREATOR_ID" type="BIGINT"/>
            <column name="TASK_ID" type="BIGINT">
                <constraints unique="true" uniqueConstraintName="UK_PROCESSES_ID"/>
            </column>
            <column name="WORKFLOW_ID" type="BIGINT">
                <constraints foreignKeyName="FK_WORKFLOW_WORK" references="PROCESSES_WORK_FLOW(WORK_FLOW_ID)"
                             nullable="false"/>
            </column>
            <column name="IS_DRAFT" type="BOOLEAN"/>
            <column name="CREATED_DATE" type="DATE"/>
            <column name="MODIFIED_DATE" type="DATE"/>
        </createTable>
        <modifySql dbms="mysql">
            <append value=" ENGINE=INNODB CHARSET=UTF8 COLLATE utf8_general_ci"/>
        </modifySql>
    </changeSet>

    <changeSet author="processes" id="1.0.0-3" dbms="hsqldb,oracle,postgresql">
        <createSequence sequenceName="SEQ_WORK_DRAFT_ID" startValue="1"/>
    </changeSet>

    <changeSet author="processes" id="1.0.0-4">
        <addColumn tableName="PROCESSES_WORK_FLOW">
            <column name="ILLUSTRATION_IMAGE_ID" type="BIGINT" defaultValueNumeric="0" />
        </addColumn>
    </changeSet>
    <changeSet author="processes" id="1.0.0-5" dbms="hsqldb,oracle,postgresql">
        <createSequence sequenceName="SEQ_WORK_ID" startValue="1"/>
    </changeSet>


    <changeSet author="processes" id="1.0.0-6">
        <createTable tableName="WORK_FLOW_MANAGERS">
            <column name="WORK_FLOW_ID" type="BIGINT">
                <constraints foreignKeyName="FK_WORK_FLOW_MGR_01" references="PROCESSES_WORK_FLOW(WORK_FLOW_ID)" nullable="false"/>
            </column>
            <column name="MANAGER" type="NVARCHAR(50)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <modifySql dbms="mysql">
            <append value=" ENGINE=INNODB CHARSET=UTF8 COLLATE utf8_general_ci"/>
        </modifySql>
    </changeSet>

    <changeSet author="processes" id="1.0.0-7">
        <createTable tableName="WORK_FLOW_PARTICIPATOR">
            <column name="WORK_FLOW_ID" type="BIGINT">
                <constraints foreignKeyName="FK_WORK_FLOW_PART_01" references="PROCESSES_WORK_FLOW(WORK_FLOW_ID)" nullable="false"/>
            </column>
            <column name="PARTICIPATOR" type="NVARCHAR(50)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <modifySql dbms="mysql">
            <append value=" ENGINE=INNODB CHARSET=UTF8 COLLATE utf8_general_ci"/>
        </modifySql>
    </changeSet>

    <changeSet author="processes" id="1.0.0-8">
        <modifyDataType tableName="WORK_FLOW_MANAGERS" columnName="MANAGER" newDataType="NVARCHAR(300)"/>
        <modifyDataType tableName="WORK_FLOW_PARTICIPATOR" columnName="PARTICIPATOR" newDataType="NVARCHAR(300)"/>
    </changeSet>

    <!-- Several processes may feed one task project (EXO-91987). The rollback
         re-adds the constraint, which fails once two processes share a project. -->
    <changeSet author="processes" id="1.0.0-exo-91987-01">
        <dropUniqueConstraint tableName="PROCESSES_WORK_FLOW" constraintName="UK_PROCESSES_WORK_FLOW_PROJECT_ID"/>
        <rollback>
            <addUniqueConstraint tableName="PROCESSES_WORK_FLOW" columnNames="PROJECT_ID"
                                 constraintName="UK_PROCESSES_WORK_FLOW_PROJECT_ID"/>
        </rollback>
    </changeSet>

    <!-- The process each request task belongs to (EXO-91987). No foreign key to
         TASK_TASKS, which belongs to another domain. -->
    <changeSet author="processes" id="1.0.0-exo-91987-02">
        <createTable tableName="PROCESSES_REQUEST">
            <column name="TASK_ID" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_PROCESSES_REQUEST"/>
            </column>
            <column name="WORK_FLOW_ID" type="BIGINT">
                <constraints nullable="false" foreignKeyName="FK_PROCESSES_REQUEST_WF"
                             references="PROCESSES_WORK_FLOW(WORK_FLOW_ID)"/>
            </column>
            <column name="CREATOR_ID" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <modifySql dbms="mysql">
            <append value=" ENGINE=INNODB CHARSET=UTF8 COLLATE utf8_general_ci"/>
        </modifySql>
    </changeSet>

    <!-- The managing space of a process, and the state of the move of its
         requests to another task project (EXO-91987). Times are epoch
         milliseconds. -->
    <changeSet author="processes" id="1.0.0-exo-91987-03">
        <addColumn tableName="PROCESSES_WORK_FLOW">
            <column name="SPACE_ID" type="BIGINT"/>
            <column name="PROJECT_MOVE_PENDING" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="MOVE_SEQ" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="MOVE_OWNER" type="VARCHAR(64)"/>
            <column name="MOVE_LEASE_UNTIL" type="BIGINT"/>
            <column name="MOVE_ATTEMPTS" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="MOVE_NEXT_ATTEMPT" type="BIGINT"/>
            <column name="MOVE_REQUESTED_BY" type="VARCHAR(200)"/>
        </addColumn>
        <createIndex tableName="PROCESSES_WORK_FLOW" indexName="IDX_PROCESSES_WORK_FLOW_01">
            <column name="PROJECT_MOVE_PENDING"/>
            <column name="MOVE_NEXT_ATTEMPT"/>
        </createIndex>
    </changeSet>

    <!-- Kept apart from the table creation: the MySQL suffix above is appended
         to every statement of its changeset. -->
    <changeSet author="processes" id="1.0.0-exo-91987-04">
        <!-- Serves the keyset read of a process's requests by task id -->
        <createIndex tableName="PROCESSES_REQUEST" indexName="IDX_PROCESSES_REQUEST_01">
            <column name="WORK_FLOW_ID"/>
            <column name="TASK_ID"/>
        </createIndex>
        <createIndex tableName="PROCESSES_REQUEST" indexName="IDX_PROCESSES_REQUEST_02">
            <column name="CREATOR_ID"/>
        </createIndex>
        <!-- MySQL may drop the index it made for FK_PROCESSES_REQUEST_WF once
             IDX_PROCESSES_REQUEST_01 can serve the key, and then refuses to drop
             IDX_PROCESSES_REQUEST_01: an index on WORK_FLOW_ID is created first.
             It is dropped with the table when the rollback goes on through
             1.0.0-exo-91987-02, and stays, redundant, when this changeset alone
             is rolled back then applied again. -->
        <rollback>
            <createIndex tableName="PROCESSES_REQUEST" indexName="IDX_PROCESSES_REQUEST_03">
                <column name="WORK_FLOW_ID"/>
            </createIndex>
            <dropIndex tableName="PROCESSES_REQUEST" indexName="IDX_PROCESSES_REQUEST_01"/>
            <dropIndex tableName="PROCESSES_REQUEST" indexName="IDX_PROCESSES_REQUEST_02"/>
        </rollback>
    </changeSet>

    <!-- The labels a process applies to each request it creates (EXO-91988):
         ids of Task labels, with no foreign key to TASK_LABELS, since a label
         deleted in Tasks is left out when the process is read. The primary
         key's leading column serves the foreign key, so MySQL adds no index
         of its own, and dropping the table drops both keys with it. -->
    <changeSet author="processes" id="1.0.0-exo-91988-01">
        <createTable tableName="PROCESSES_WORK_FLOW_LABELS">
            <column name="WORK_FLOW_ID" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="PK_PROCESSES_WF_LABELS" foreignKeyName="FK_PROCESSES_WF_LABELS_WF" references="PROCESSES_WORK_FLOW(WORK_FLOW_ID)" nullable="false"/>
            </column>
            <column name="LABEL_ID" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="PK_PROCESSES_WF_LABELS" nullable="false"/>
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="PROCESSES_WORK_FLOW_LABELS"/>
        </rollback>
        <modifySql dbms="mysql">
            <append value=" ENGINE=INNODB CHARSET=UTF8 COLLATE utf8_general_ci"/>
        </modifySql>
    </changeSet>

</databaseChangeLog>

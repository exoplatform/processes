<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <artifactId>addons-exo-parent-pom</artifactId>
        <groupId>org.exoplatform.addons</groupId>
        <version>21-M02</version>
    </parent>
    <groupId>org.exoplatform.processes</groupId>
    <artifactId>processes-parent</artifactId>
    <version>7.3.x-maintenance-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>eXo Processes - Parent POM</name>
    <modules>
        <module>processes-api</module>
        <module>processes-services</module>
        <module>processes-webapp</module>
        <module>processes-packaging</module>
    </modules>
    <scm>
        <connection>scm:git:git://github.com/exoplatform/processes.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/exoplatform/processes.git</developerConnection>
        <url>https://github.com/exoplatform/processes</url>
        <tag>HEAD</tag>
    </scm>
    <properties>
      <!-- Lombok 1.18.40 or later runs on JDK 25: the delombok of the API module needs it -->
      <org.lombok.version>1.18.46</org.lombok.version>
        <!-- 3rd party libraries versions -->
        <addon.exo.ecms.version>7.3.x-maintenance-SNAPSHOT</addon.exo.ecms.version>
        <!-- Sonar properties -->
    <sonar.organization>exoplatform</sonar.organization>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.exoplatform.ecms</groupId>
                <artifactId>ecms</artifactId>
                <version>${addon.exo.ecms.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Current project artifacts -->
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>processes-api</artifactId>
                <version>${project.version}</version>
                <scope>provided</scope>
            </dependency>

            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>processes-services</artifactId>
                <version>${project.version}</version>
                <scope>provided</scope>
            </dependency>

            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>processes-webapp</artifactId>
                <version>${project.version}</version>
                <scope>provided</scope>
                <type>war</type>
            </dependency>

            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>processes-packaging</artifactId>
                <version>${project.version}</version>
                <scope>provided</scope>
                <type>war</type>
            </dependency>
        </dependencies>
    </dependencyManagement>
  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <!-- Since JDK 23, javac runs an annotation processor found on the class path, such as Lombok, only when asked to -->
            <proc>full</proc>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
    <profiles>
        <profile>
            <id>project-repositories</id>
            <activation>
                <property>
                    <name>!skip-project-repositories</name>
                </property>
            </activation>
            <repositories>
                <repository>
                    <snapshots>
                        <enabled>true</enabled>
                    </snapshots>
                    <id>repository.exoplatform.org</id>
                    <url>https://repository.exoplatform.org/public</url>
                </repository>
            </repositories>
            <pluginRepositories>
                <pluginRepository>
                    <snapshots>
                        <enabled>true</enabled>
                    </snapshots>
                    <id>repository.exoplatform.org</id>
                    <url>https://repository.exoplatform.org/public</url>
                </pluginRepository>
            </pluginRepositories>
        </profile>
    </profiles>
</project>
